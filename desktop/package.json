{
    "name": "infinite-canvas-desktop",
    "version": "0.1.0",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "build:main": "tsc -p tsconfig.json",
        "build:renderer": "node scripts/build-renderer.mjs",
        "build": "npm run build:main && npm run build:renderer",
        "dev": "npm run build:main && electron .",
        "icon": "node scripts/generate-icon.mjs",
        "dist:win": "npm run build && electron-builder --win"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "electron": "^33.0.0",
        "electron-builder": "^25.1.0",
        "png-to-ico": "^2.1.8",
        "sharp": "^0.33.5",
        "typescript": "^5.8.0"
    },
    "build": {
        "appId": "com.basketikun.infinite-canvas",
        "productName": "无限画布",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "renderer/**/*",
            "build/icon.ico"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "allowScripts": {
        "electron@33.4.11": true,
        "sharp@0.33.5": true
    }
}
